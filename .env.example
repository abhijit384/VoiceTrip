# ==============================================================================
# RIME VOICE TRAVEL ASSISTANT - ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your private API keys.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Rime TTS Configuration (REQUIRED FOR PRIMARY SPOKEN VOICE) ---
RIME_API_KEY=your_rime_api_key_here
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=mist
RIME_SPEAKER=amber
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLE_RATE=24000
RIME_SPEED_ALPHA=1.0

# --- LLM Service Configuration (Google Gemini 3.6 Flash via google-genai) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- STT Service Configuration (Deepgram Flux / Nova) ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_LANGUAGE=en

# --- LiveKit Realtime Configuration ---
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Supabase Database Configuration (Optional for persistence) ---
# Server-Side Configuration:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Client-Side Configuration (Vite - Publishable Key Only):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# --- Server & App Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUG=true
LOG_LEVEL=INFO

# --- Simulation / Tool Stress Test Settings ---
TOOL_ARTIFICIAL_DELAY_SECONDS=5.0
